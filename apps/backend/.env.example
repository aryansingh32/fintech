# Database
DATABASE_URL="postgresql://sptc:sptc_dev_password@localhost:5432/sptc_finance?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# OTP
OTP_TTL_SECONDS="300"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="45"
OTP_MAX_REQUESTS_PER_HOUR="5"

# SMS provider (leave blank in dev - system will report "not configured" rather than fake success)
# Supported: "twilio"
SMS_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Push provider - "expo" (default; works with no setup) or "fcm" (real Firebase Cloud
# Messaging - requires FIREBASE_SERVICE_ACCOUNT_JSON below, and the app to register a
# native device token rather than an Expo token, which it does automatically once
# google-services.json is present in android/app).
PUSH_PROVIDER="expo"

# Firebase Admin SDK - required for PUSH_PROVIDER=fcm and for Google Sign-In
# (POST /auth/customer/google, POST /auth/staff/google). Get this from Firebase Console
# > Project Settings > Service Accounts > Generate New Private Key, then paste the
# entire JSON file contents here as a single-line string. Leave blank to disable both.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Payment gateway (leave blank in dev - system will report "not configured" rather than fake success)
# Supported: "razorpay"
PAYMENT_GATEWAY_PROVIDER=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# File storage (leave blank in dev - photo/document uploads will fail closed
# with a clear "not configured" error rather than silently no-op-ing)
# Supported: "r2" (Cloudflare R2, S3-compatible)
STORAGE_PROVIDER=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# App
PORT="3000"
NODE_ENV="development"
CORS_ORIGINS="http://localhost:19006"

# Super admin seed (optional - prisma/seed.ts only creates this account when
# all of these are set; leave blank to skip in shared/CI environments)
SEED_SUPERADMIN_NAME=""
SEED_SUPERADMIN_MOBILE=""
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""
