# Database
DATABASE_URL="postgresql://sptc:sptc_dev_password@localhost:5432/sptc_finance?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# OTP
OTP_TTL_SECONDS="300"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="45"
OTP_MAX_REQUESTS_PER_HOUR="5"

# SMS provider (leave blank in dev - system will report "not configured" rather than fake success)
# Supported: "twilio"
SMS_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Push provider (leave blank in dev - Expo push tokens work with no account/API key needed,
# so this only needs to be set to disable push entirely; see PUSH_PROVIDER below)
# Supported: "expo"
PUSH_PROVIDER="expo"

# Payment gateway (leave blank in dev - system will report "not configured" rather than fake success)
# Supported: "razorpay"
PAYMENT_GATEWAY_PROVIDER=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# App
PORT="3000"
NODE_ENV="development"
CORS_ORIGINS="http://localhost:19006"
