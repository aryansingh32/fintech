# Production environment template. Copy to the deployment target's secret
# store (never commit a real .env.production) and fill in every value below.
# main.ts refuses to boot in production if any of these are missing, too
# short, or left as an obvious placeholder - see src/config/validate-production-env.ts.

# Database - use a connection pooler (PgBouncer/RDS Proxy) in front of Postgres
# under real concurrent load; Prisma's own pool is per-instance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sptc_finance?schema=public&sslmode=require"

# Only needed for the self-hosted single-VM stack in infra/oracle/ (a managed
# DB provider sets its own password and DATABASE_URL above already includes
# it, so leave these two blank in that case). POSTGRES_PASSWORD seeds the
# Postgres container's password AND is substituted into DATABASE_URL above
# by infra/oracle/docker-compose.prod.yml - generate with
# `openssl rand -base64 24`. DOMAIN is the public DNS name (A record already
# pointed at the VM's public IP) that Caddy requests a Let's Encrypt
# certificate for - see docs/ORACLE_DEPLOYMENT.md.
POSTGRES_PASSWORD=""
DOMAIN=""

# JWT - generate with: openssl rand -base64 48
# Must be at least 32 chars, and access/refresh secrets must differ.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# OTP
OTP_TTL_SECONDS="300"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="45"
OTP_MAX_REQUESTS_PER_HOUR="5"

# Set to "true" ONLY as a temporary measure while SMS_PROVIDER is blank and
# you have no real SMS gateway yet: it returns the OTP in the API response
# instead of failing the request, and both apps display it via the
# "Dynamic Island" banner (src/components/OtpIslandBanner.tsx) so login
# still works end-to-end. Anyone who can see the network response (or the
# on-screen banner) can see the OTP - remove this and set SMS_PROVIDER
# once a real provider (Twilio) is configured, before handling real
# customer accounts at scale.
ALLOW_DEV_OTP="false"

# SMS provider - required in production (OTP delivery fails closed without it)
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Push provider - Expo push tokens need no separate account/API key
PUSH_PROVIDER="expo"

# Payment gateway - required in production for customer-initiated online payments
PAYMENT_GATEWAY_PROVIDER="razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# File storage - required in production (customer/reference photo and KYC
# document uploads fail closed without it). Cloudflare R2, S3-compatible.
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# Daily encrypted database backups - required in production (see
# src/backup/backup.service.ts). Runs every night at 02:00 server time,
# dumps the whole Postgres database, encrypts it, and uploads it to
# BACKUP_R2_BUCKET_NAME using the same R2 account/credentials above.
#
# BACKUP_R2_BUCKET_NAME MUST be a separate, private R2 bucket from
# R2_BUCKET_NAME - do NOT reuse the storage bucket, and do NOT enable
# public access / a public r2.dev URL on it, since R2_BUCKET_NAME above is
# served publicly and backup file names are predictable (daily/YYYY-MM-DD).
# Create it once via the Cloudflare dashboard (R2 > Create bucket) and make
# sure your R2 API token's permissions cover it.
#
# BACKUP_ENCRYPTION_PASSPHRASE must be a long random secret (32+ chars,
# e.g. `openssl rand -base64 32`) kept somewhere safe OUTSIDE this repo and
# outside the server itself (a password manager) - if it's ever lost, every
# existing backup becomes permanently unreadable, and if it's ever leaked
# alongside the backup files, they can be decrypted. Losing it does NOT
# affect the live database, only the ability to restore old backups.
BACKUP_ENCRYPTION_PASSPHRASE=""
BACKUP_R2_BUCKET_NAME=""

# Optional: lets a SUPER_ADMIN manually export one backup to their own
# Google Drive from the Business App. See src/backup/google-drive.service.ts
# for the one-time interactive OAuth setup required to get these three
# values - it cannot be scripted. Leave blank to disable.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""

# App
PORT="3000"
NODE_ENV="production"
# Comma-separated, exact origins only (no wildcards) - the domains the two
# mobile apps' webviews/dev tools or any admin web console are served from.
CORS_ORIGINS="https://app.sptcfinance.example.com"
